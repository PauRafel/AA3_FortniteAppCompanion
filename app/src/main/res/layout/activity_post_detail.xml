<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_post_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ProgressBar
        android:id="@+id/progressBarPostDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:visibility="visible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txt_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Post Title"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#212121"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/txt_detail_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Post content goes here..."
                        android:textSize="16sp"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#424242"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="20dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/txt_detail_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email: user@example.com"
                        android:textSize="14sp"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#757575"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txt_detail_timestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Posted: 20/01/2026 at 12:00"
                        android:textSize="14sp"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#757575"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Replies"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#212121"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/txt_no_replies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No replies yet. Be the first to reply!"
                        android:textSize="14sp"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#999999"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewReplies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Write a Reply"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/edit_reply_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Write your reply here..."
                        android:minHeight="100dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:fontFamily="@font/fortnitefont"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_send_reply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Send Reply"
                        android:fontFamily="@font/fortnitefont"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/purple"
                        android:padding="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>