<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/fortnitefont</item>
        <item name="android:textSize">30dp</item>
    </style>
    <style name="NavbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/fortnitefont</item>
        <item name="android:textSize">20dp</item>
    </style>
    <style name="BottomNavActiveIndicatorSquare"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/SquareShape</item>
    </style>

    <style name="SquareShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

</resources>